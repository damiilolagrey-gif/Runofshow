PORT=3000
BASE_URL=https://your-domain.example      # used in links inside WhatsApp messages
DATA_DIR=./data                           # SQLite file and generated push keys live here

# Browser push. Leave blank to auto-generate keys into DATA_DIR on first run.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# WhatsApp Cloud API (Meta). Leave blank and messages are only logged; planners can still
# send them by hand with the "Send on WhatsApp" links.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=          # approved template with one body variable {{1}}; needed outside the 24h window
WHATSAPP_TEMPLATE_LANG=en

# Paystack: planner subscriptions, event unlocks, aso-ebi card payments. Leave blank and plan
# limits are off and aso-ebi is bank-transfer only. Webhook URL: <BASE_URL>/api/paystack/webhook
PAYSTACK_SECRET_KEY=

# Prices in kobo (₦15,000 = 1500000) and the aso-ebi platform fee in percent.
PRICE_PRO_MONTHLY=1500000
PRICE_PRO_YEARLY=15000000
PRICE_BUSINESS_MONTHLY=4000000
PRICE_BUSINESS_YEARLY=40000000
PRICE_EVENT=2000000
ASOEBI_FEE_PERCENT=1.5
