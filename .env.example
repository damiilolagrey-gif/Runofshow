PORT=3000
BASE_URL=https://your-domain.example      # used in links inside WhatsApp messages
DATA_DIR=./data                           # SQLite file and generated push keys live here

# Browser push. Leave blank to auto-generate keys into DATA_DIR on first run.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# WhatsApp Cloud API (Meta). Leave blank and messages are only logged; planners can still
# send them by hand with the "Send on WhatsApp" links.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=          # approved template with one body variable {{1}}; needed outside the 24h window
WHATSAPP_TEMPLATE_LANG=en

# Paystack (card and bank payments for aso-ebi). Leave blank to use bank transfer only.
PAYSTACK_SECRET_KEY=
